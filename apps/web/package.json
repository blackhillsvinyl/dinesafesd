    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^4.5.0",
    "axe-core": "^4.14.0",
    "puppeteer": "^23.11.1",
    "tsx": "^4.23.15",
